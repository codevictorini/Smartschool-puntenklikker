{
  "manifest_version": 3,
  "name": "Smartschool PuntKlik",
  "version": "3.5.0",
  "description": "Tik je punt tevoorschijn, verzamel coins en kies je klikfiguur.",
  "permissions": [
    "storage",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.smartschool.be/*"
      ],
      "js": [
        "skins.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.svg"
      ],
      "matches": [
        "https://*.smartschool.be/*"
      ]
    }
  ],
  "action": {
    "default_title": "PuntKlik",
    "default_popup": "store.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}